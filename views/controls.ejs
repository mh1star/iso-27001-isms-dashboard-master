<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الضوابط الأمنية - ISO 27001 ISMS</title>
    
    <!-- Bootstrap CSS -->
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/vendor/fontawesome/all.min.css">
    
    <!-- DataTables -->
    <link rel="stylesheet" href="/vendor/datatables/dataTables.bootstrap5.min.css">
    
    <style>
        :root {
            --primary-color: #1e3a8a;
            --secondary-color: #3b82f6;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --light-color: #f8fafc;
        }
        body { background-color: var(--light-color); font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); min-height: 100vh; box-shadow: 2px 0 10px rgba(0,0,0,0.1); }
        .sidebar .nav-link { color: rgba(255,255,255,0.9); padding: 0.75rem 1rem; margin: 0.25rem 0; border-radius: 0.5rem; transition: all 0.3s ease; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: rgba(255,255,255,0.2); color: white; transform: translateX(5px); }
        .card { border: none; border-radius: 1rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .iso-logo { width: 40px; height: 40px; background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; margin-right: 10px; }
.table th { background-color: var(--primary-color); color: white; border: none; }
        .control-card { border-left: 4px solid; }
        .control-implemented { border-left-color: var(--success-color); }
        .control-partial { border-left-color: var(--warning-color); }
        .control-not-implemented { border-left-color: var(--danger-color); }
    </style>
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 sidebar isms-sidebar">
                <div class="position-sticky pt-3">
                    <div class="d-flex align-items-center mb-4">
                        <div class="iso-logo">ISO</div>
                        <h5 class="text-white mb-0">27001 ISMS</h5>
                    </div>
                    
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-tachometer-alt me-2"></i>لوحة التحكم</a></li>
                        <li class="nav-item"><a class="nav-link" href="/assets"><i class="fas fa-server me-2"></i>إدارة الأصول</a></li>
                        <li class="nav-item"><a class="nav-link" href="/risks"><i class="fas fa-exclamation-triangle me-2"></i>إدارة المخاطر</a></li>
                        <li class="nav-item"><a class="nav-link" href="/incidents"><i class="fas fa-bell me-2"></i>الحوادث</a></li>
                        <li class="nav-item"><a class="nav-link" href="/policies"><i class="fas fa-file-alt me-2"></i>السياسات</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/controls"><i class="fas fa-shield-alt me-2"></i>الضوابط الأمنية</a></li>
                        <li class="nav-item"><a class="nav-link" href="/audits"><i class="fas fa-search me-2"></i>التدقيقات</a></li>
                        <li class="nav-item"><a class="nav-link" href="/reports"><i class="fas fa-chart-bar me-2"></i>التقارير</a></li>
                    </ul>
                    
                    <hr class="text-white my-4">
                    
                    <div class="text-white small">
                        <h6 class="text-white">عمل الطالب محمد علي طاهر</h6>
                        <p class="mb-1">إدارة أمن المعلومات</p>
                        <p class="mb-0">التطبيق الاحترافي</p>
                    </div>
                </div>
            </nav>
            
            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="pt-3 pb-2 mb-3">
                    <!-- Header -->
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center border-bottom mb-4">
                        <h1 class="h2 text-primary">
                            <i class="fas fa-shield-alt me-2"></i>
                            الضوابط الأمنية (الملحق A من ISO 27001)
                        </h1>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#assessmentModal">
                            <i class="fas fa-clipboard-check me-1"></i>التقييم
                        </button>
                    </div>
                    
                    <!-- Controls Overview -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card text-center bg-success text-white">
                                <div class="card-body">
                                    <h3><%= controls.filter(c => c.status === 'Implemented').length %></h3>
                                    <p class="mb-0">مطبق</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-warning text-white">
                                <div class="card-body">
                                    <h3><%= controls.filter(c => c.status === 'Partially Implemented').length %></h3>
                                    <p class="mb-0">مطبق جزئيًا</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-danger text-white">
                                <div class="card-body">
                                    <h3><%= controls.filter(c => c.status === 'Not Implemented').length %></h3>
                                    <p class="mb-0">غير مطبق</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-primary text-white">
                                <div class="card-body">
                                    <h3><%= controls.length ? Math.round((controls.filter(c => c.status === 'Implemented').length / controls.length) * 100) : 0 %>%</h3>
                                    <p class="mb-0">نسبة الامتثال</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- الضوابط حسب التصنيف -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="fas fa-sitemap me-2"></i>الضوابط حسب التصنيف</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <% 
                                        const categories = [...new Set(controls.map(c => c.category))];
                                        categories.forEach(category => {
                                            const categoryControls = controls.filter(c => c.category === category);
                                            const implemented = categoryControls.filter(c => c.status === 'Implemented').length;
                                            // categoryControls.length is never 0 here, but the
                                            // guard keeps this safe if the list is ever empty.
                                            const percentage = categoryControls.length ? Math.round((implemented / categoryControls.length) * 100) : 0;
                                        %>
                                        <div class="col-md-4 mb-3">
                                            <h6 class="text-primary"><%= ar('controlCategory', category) %></h6>
                                            <div class="progress mb-2">
                                                <div class="progress-bar bg-<%= percentage >= 80 ? 'success' : percentage >= 50 ? 'warning' : 'danger' %>" 
                                                     role="progressbar" aria-valuenow="<%= percentage %>" aria-valuemin="0" aria-valuemax="100"
                                                     style="width: <%- percentage %>%">
                                                    <%= percentage %>%
                                                </div>
                                            </div>
                                            <small class="text-muted"><%= implemented %> من <%= categoryControls.length %> ضابط مطبق</small>
                                        </div>
                                        <% }); %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Controls Cards -->
                    <div class="row mb-4">
                        <% controls.forEach(control => { %>
                            <div class="col-md-6 mb-3">
                                <div class="card control-card control-<%= control.status.toLowerCase().replace(/\s+/g, '-') %> h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <h6 class="card-title text-primary mb-0">
                                                <strong><%= control.id %></strong> - <%= control.name %>
                                            </h6>
                                            <span class="badge bg-<%= control.status === 'Implemented' ? 'success' : control.status === 'Partially Implemented' ? 'warning' : 'danger' %>">
                                                <%= ar('status', control.status) %>
                                            </span>
                                        </div>
                                        <div class="mb-3">
                                            <div class="form-label small text-muted d-block">مستوى الفعالية</div>
                                            <div class="progress">
                                                <div class="progress-bar bg-<%= control.effectiveness >= 80 ? 'success' : control.effectiveness >= 60 ? 'warning' : 'danger' %>" 
                                                     role="progressbar" aria-valuenow="<%= control.effectiveness %>" aria-valuemin="0" aria-valuemax="100"
                                                     style="width: <%- control.effectiveness %>%">
                                                    <%= control.effectiveness %>%
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row small text-muted">
                                            <div class="col-6">
                                                <strong>التصنيف:</strong> <%= ar('controlCategory', control.category) %>
                                            </div>
                                            <div class="col-6">
                                                <strong>آخر تقييم:</strong> <%= moment(control.lastAssessed).isValid() ? moment(control.lastAssessed).format('DD/MM/YYYY') : '—' %>
                                            </div>
                                            <div class="col-12 mt-1">
                                                <strong>المراجعة القادمة:</strong> <%= moment(control.nextReview).isValid() ? moment(control.nextReview).format('DD/MM/YYYY') : '—' %>
                                            </div>
                                        </div>
                                        <div class="mt-3">
                                            <button class="btn btn-sm btn-outline-primary me-2" type="button">
                                                <i class="fas fa-clipboard-check"></i> تقييم
                                            </button>
                                            <button class="btn btn-sm btn-outline-info" type="button">
                                                <i class="fas fa-eye"></i> التفاصيل
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    
                    <!-- Controls Table -->
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-list me-2"></i>سجل الضوابط الأمنية</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped data-table" id="controlsTable">
                                    <thead>
                                        <tr>
                                            <th>معرّف الضابط</th>
                                            <th>اسم الضابط</th>
                                            <th>التصنيف</th>
                                            <th>الحالة</th>
                                            <th>الفعالية</th>
                                            <th>آخر تقييم</th>
                                            <th>المراجعة القادمة</th>
                                            <th>الإجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% controls.forEach(control => { %>
                                            <tr>
                                                <td data-sort="<%= control.id %>"><strong><%= control.id %></strong></td>
                                                <td><%= control.name %></td>
                                                <td><%= ar('controlCategory', control.category) %></td>
                                                <td>
                                                    <span class="badge bg-<%= control.status === 'Implemented' ? 'success' : control.status === 'Partially Implemented' ? 'warning' : 'danger' %>">
                                                        <%= ar('status', control.status) %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="progress" style="height: 20px;">
                                                        <div class="progress-bar bg-<%= control.effectiveness >= 80 ? 'success' : control.effectiveness >= 60 ? 'warning' : 'danger' %>" 
                                                             role="progressbar" aria-valuenow="<%= control.effectiveness %>" aria-valuemin="0" aria-valuemax="100"
                                                             style="width: <%- control.effectiveness %>%">
                                                            <%= control.effectiveness %>%
                                                        </div>
                                                    </div>
                                                </td>
                                                <td data-sort="<%= control.lastAssessed %>"><%= moment(control.lastAssessed).isValid() ? moment(control.lastAssessed).format('DD/MM/YYYY') : '—' %></td>
                                                <td data-sort="<%= control.nextReview %>"><%= moment(control.nextReview).isValid() ? moment(control.nextReview).format('DD/MM/YYYY') : '—' %></td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary" title="تقييم الضابط" type="button">
                                                        <i class="fas fa-clipboard-check"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-info" title="عرض الأدلة" type="button">
                                                        <i class="fas fa-folder-open"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    
    <!-- تقييم ضابط Modal — the header button pointed at this id but no such
         element existed, so the primary action on the page did nothing. -->
    <div class="modal fade" id="assessmentModal" tabindex="-1" aria-labelledby="assessmentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="assessmentModalLabel"><i class="fas fa-clipboard-check me-2"></i>تقييم ضابط أمني</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <form action="/controls" method="POST">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="controlId" class="form-label">معرّف الضابط *</label>
                                    <input type="text" class="form-control" id="controlId" name="id" placeholder="A.5.1.1" required>
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label for="controlName" class="form-label">اسم الضابط *</label>
                                    <input type="text" class="form-control" id="controlName" name="name" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="controlStatus" class="form-label">الحالة *</label>
                                    <select class="form-select" id="controlStatus" name="status" required>
                                        <option value="">اختر الحالة</option>
                                        <option value="Implemented">مطبق</option>
                                        <option value="Partially Implemented">مطبق جزئيًا</option>
                                        <option value="Not Implemented">غير مطبق</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="controlCategory" class="form-label">التصنيف *</label>
                                    <select class="form-select" id="controlCategory" name="category" required>
                                        <option value="">اختر التصنيف</option>
                                        <option value="Organizational">تنظيمي</option>
                                        <option value="Access Control">التحكم بالوصول</option>
                                        <option value="Systems Security">أمن الأنظمة</option>
                                        <option value="Physical Security">الأمن المادي</option>
                                        <option value="Compliance">الامتثال</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="controlEffectiveness" class="form-label">مستوى الفعالية (0-100) *</label>
                                    <input type="number" class="form-control" id="controlEffectiveness" name="effectiveness" min="0" max="100" step="1" value="0" required>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label for="controlLastAssessed" class="form-label">آخر تقييم *</label>
                                    <input type="date" class="form-control" id="controlLastAssessed" name="lastAssessed" required>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="mb-3">
                                    <label for="controlNextReview" class="form-label">المراجعة القادمة *</label>
                                    <input type="date" class="form-control" id="controlNextReview" name="nextReview" required>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>حفظ التقييم</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="/vendor/datatables/dataTables.bootstrap5.min.js"></script>
    
    <script>
        if (window.jQuery && jQuery.fn && jQuery.fn.DataTable) {
            jQuery(document).ready(function() {
                $('#controlsTable').DataTable({
                    pageLength: 10,
                    order: [[0, 'asc']], // Sort by معرّف الضابط (numeric segment aware)
                    columnDefs: [
                        { targets: 0, type: 'num' } // A.12.6.1 must not sort before A.5.1.1
                    ],
                    language: {
                        emptyTable: 'لا توجد ضوابط مسجلة',
                        search: 'بحث:',
                        lengthMenu: 'عرض _MENU_ سجل لكل صفحة',
                        info: 'عرض _START_ إلى _END_ من _TOTAL_ سجل'
                    }
                });
            });
        }
    </script>
    <script src="/js/main.js"></script>
</body>
</html>
