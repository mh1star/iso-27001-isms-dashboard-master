<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة التدقيق - ISO 27001 ISMS</title>
    
    <!-- Bootstrap CSS -->
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/vendor/fontawesome/all.min.css">
    
    <!-- DataTables -->
    <link rel="stylesheet" href="/vendor/datatables/dataTables.bootstrap5.min.css">
    
    <style>
        :root {
            --primary-color: #1e3a8a;
            --secondary-color: #3b82f6;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --light-color: #f8fafc;
        }
        body { background-color: var(--light-color); font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); min-height: 100vh; box-shadow: 2px 0 10px rgba(0,0,0,0.1); }
        .sidebar .nav-link { color: rgba(255,255,255,0.9); padding: 0.75rem 1rem; margin: 0.25rem 0; border-radius: 0.5rem; transition: all 0.3s ease; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: rgba(255,255,255,0.2); color: white; transform: translateX(5px); }
        .card { border: none; border-radius: 1rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .iso-logo { width: 40px; height: 40px; background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; margin-right: 10px; }
.table th { background-color: var(--primary-color); color: white; border: none; }
    </style>
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 sidebar isms-sidebar">
                <div class="position-sticky pt-3">
                    <div class="d-flex align-items-center mb-4">
                        <div class="iso-logo">ISO</div>
                        <h5 class="text-white mb-0">27001 ISMS</h5>
                    </div>
                    
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-tachometer-alt me-2"></i>لوحة التحكم</a></li>
                        <li class="nav-item"><a class="nav-link" href="/assets"><i class="fas fa-server me-2"></i>إدارة الأصول</a></li>
                        <li class="nav-item"><a class="nav-link" href="/risks"><i class="fas fa-exclamation-triangle me-2"></i>إدارة المخاطر</a></li>
                        <li class="nav-item"><a class="nav-link" href="/incidents"><i class="fas fa-bell me-2"></i>الحوادث</a></li>
                        <li class="nav-item"><a class="nav-link" href="/policies"><i class="fas fa-file-alt me-2"></i>السياسات</a></li>
                        <li class="nav-item"><a class="nav-link" href="/controls"><i class="fas fa-shield-alt me-2"></i>الضوابط الأمنية</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/audits"><i class="fas fa-search me-2"></i>التدقيقات</a></li>
                        <li class="nav-item"><a class="nav-link" href="/reports"><i class="fas fa-chart-bar me-2"></i>التقارير</a></li>
                    </ul>
                    
                    <hr class="text-white my-4">
                    
                    <div class="text-white small">
                        <h6 class="text-white">عمل الطالب محمد علي طاهر</h6>
                        <p class="mb-1">إدارة أمن المعلومات</p>
                        <p class="mb-0">التطبيق الاحترافي</p>
                    </div>
                </div>
            </nav>
            
            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="pt-3 pb-2 mb-3">
                    <!-- Header -->
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center border-bottom mb-4">
                        <h1 class="h2 text-primary">
                            <i class="fas fa-search me-2"></i>
                            إدارة التدقيق (ISO 27001 A.18.2)
                        </h1>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#scheduleAuditModal">
                            <i class="fas fa-calendar-plus me-1"></i>جدولة تدقيق
                        </button>
                    </div>
                    
                    <!-- Audit Statistics -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card text-center bg-primary text-white">
                                <div class="card-body">
                                    <h3><%= audits.length %></h3>
                                    <p class="mb-0">إجمالي التدقيقات</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-success text-white">
                                <div class="card-body">
                                    <h3><%= audits.filter(a => a.status === 'Completed').length %></h3>
                                    <p class="mb-0">مكتمل</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-warning text-white">
                                <div class="card-body">
                                    <h3><%= audits.filter(a => a.status === 'Scheduled').length %></h3>
                                    <p class="mb-0">مجدول</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-info text-white">
                                <div class="card-body">
                                    <h3><%= audits.filter(a => a.type === 'Internal').length %></h3>
                                    <p class="mb-0">التدقيقات الداخلية</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Audit Calendar -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="fas fa-calendar me-2"></i>جدول التدقيقات</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6 class="text-primary">التدقيقات القادمة</h6>
                                            <% 
                                            const upcomingAudits = audits.filter(a => moment(a.startDate).isAfter(moment()) && a.status === 'Scheduled');
                                            if (upcomingAudits.length > 0) {
                                            %>
                                                <% upcomingAudits.forEach(audit => { %>
                                                    <div class="border-start border-primary border-3 ps-3 mb-3">
                                                        <h6 class="mb-1"><%= audit.title %></h6>
                                                        <p class="mb-1 text-muted"><%= audit.auditor %></p>
                                                        <small class="text-muted">
                                                            <i class="fas fa-calendar me-1"></i>
                                                            <%= moment(audit.startDate).format('DD/MM/YYYY') %> - <%= moment(audit.endDate).format('DD/MM/YYYY') %>
                                                        </small>
                                                    </div>
                                                <% }); %>
                                            <% } else { %>
                                                <p class="text-muted">لا توجد تدقيقات قادمة مجدولة</p>
                                            <% } %>
                                        </div>
                                        <div class="col-md-6">
                                            <h6 class="text-success">أحدث التدقيقات المكتملة</h6>
                                            <% 
                                            const recentAudits = audits.filter(a => a.status === 'Completed').slice(0, 3);
                                            if (recentAudits.length > 0) {
                                            %>
                                                <% recentAudits.forEach(audit => { %>
                                                    <div class="border-start border-success border-3 ps-3 mb-3">
                                                        <h6 class="mb-1"><%= audit.title %></h6>
                                                        <p class="mb-1 text-muted"><%= audit.auditor %></p>
                                                        <small class="text-muted">
                                                            <i class="fas fa-check-circle me-1"></i>
                                                            مكتمل <%= moment(audit.endDate).format('DD/MM/YYYY') %>
                                                        </small>
                                                    </div>
                                                <% }); %>
                                            <% } else { %>
                                                <p class="text-muted">لا توجد تدقيقات مكتملة حديثًا</p>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- التدقيقات Table -->
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-list me-2"></i>سجل التدقيقات</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped data-table" id="auditsTable">
                                    <thead>
                                        <tr>
                                            <th>عنوان التدقيق</th>
                                            <th>النوع</th>
                                            <th>الحالة</th>
                                            <th>المدقق</th>
                                            <th>تاريخ البدء</th>
                                            <th>تاريخ الانتهاء</th>
                                            <th>الملاحظات</th>
                                            <th>التوصيات</th>
                                            <th>الإجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% audits.forEach(audit => { %>
                                            <tr>
                                                <td><strong><%= audit.title %></strong></td>
                                                <td>
                                                    <span class="badge bg-<%= audit.type === 'Internal' ? 'info' : audit.type === 'External' ? 'warning' : 'secondary' %>">
                                                        <%= ar('auditType', audit.type) %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-<%= audit.status === 'Completed' ? 'success' : audit.status === 'Scheduled' ? 'warning' : audit.status === 'In Progress' ? 'info' : 'secondary' %>">
                                                        <%= ar('status', audit.status) %>
                                                    </span>
                                                </td>
                                                <td><%= audit.auditor %></td>
                                                <td data-sort="<%= audit.startDate %>"><%= moment(audit.startDate).isValid() ? moment(audit.startDate).format('DD/MM/YYYY') : '—' %></td>
                                                <td data-sort="<%= audit.endDate %>"><%= moment(audit.endDate).isValid() ? moment(audit.endDate).format('DD/MM/YYYY') : '—' %></td>
                                                <td>
                                                    <% if (audit.findings > 0) { %>
                                                        <span class="badge bg-danger"><%= audit.findings %></span>
                                                    <% } else { %>
                                                        <span class="text-muted">-</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <% if (audit.recommendations > 0) { %>
                                                        <span class="badge bg-info"><%= audit.recommendations %></span>
                                                    <% } else { %>
                                                        <span class="text-muted">-</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary" title="تعديل التدقيق" type="button">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <% if (audit.status === 'Completed') { %>
                                                        <button class="btn btn-sm btn-outline-success" title="عرض التقرير" type="button">
                                                            <i class="fas fa-file-alt"></i>
                                                        </button>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    
    <!-- جدولة تدقيق Modal — the header button targeted this id but the element
         did not exist, so "جدولة تدقيق" was a dead button. -->
    <div class="modal fade" id="scheduleAuditModal" tabindex="-1" aria-labelledby="scheduleAuditModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="scheduleAuditModalLabel"><i class="fas fa-calendar-check me-2"></i>جدولة تدقيق جديد</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <form action="/audits" method="POST">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="title" class="form-label">عنوان التدقيق *</label>
                                    <input type="text" class="form-control" id="title" name="title" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="type" class="form-label">نوع التدقيق *</label>
                                    <select class="form-select" id="type" name="type" required>
                                        <option value="">اختر النوع</option>
                                        <option value="Internal">داخلي</option>
                                        <option value="External">خارجي</option>
                                        <option value="Supplier">تدقيق مورد</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="status" class="form-label">الحالة *</label>
                                    <select class="form-select" id="status" name="status" required>
                                        <option value="Scheduled">مجدول</option>
                                        <option value="In Progress">قيد التنفيذ</option>
                                        <option value="Completed">مكتمل</option>
                                        <option value="Cancelled">ملغى</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="auditor" class="form-label">الجهة المدققة *</label>
                                    <input type="text" class="form-control" id="auditor" name="auditor" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="startDate" class="form-label">تاريخ البدء *</label>
                                    <input type="date" class="form-control" id="startDate" name="startDate" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="endDate" class="form-label">تاريخ الانتهاء *</label>
                                    <input type="date" class="form-control" id="endDate" name="endDate" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="findings" class="form-label">عدد الملاحظات</label>
                                    <input type="number" class="form-control" id="findings" name="findings" min="0" step="1" value="0">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="recommendations" class="form-label">عدد التوصيات</label>
                                    <input type="number" class="form-control" id="recommendations" name="recommendations" min="0" step="1" value="0">
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>حفظ التدقيق</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="/vendor/datatables/dataTables.bootstrap5.min.js"></script>
    
    <script>
        if (window.jQuery && jQuery.fn && jQuery.fn.DataTable) {
            jQuery(document).ready(function() {
                $('#auditsTable').DataTable({
                    pageLength: 10,
                    order: [[4, 'desc']], // Sort by تاريخ البدء
                    language: {
                        emptyTable: 'لا توجد تدقيقات مسجلة',
                        search: 'بحث:',
                        lengthMenu: 'عرض _MENU_ سجل لكل صفحة',
                        info: 'عرض _START_ إلى _END_ من _TOTAL_ سجل'
                    }
                });
            });
        }
    </script>
    <script src="/js/main.js"></script>
</body>
</html>
