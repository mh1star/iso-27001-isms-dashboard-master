<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة الأصول - ISO 27001 ISMS</title>
    
    <!-- Bootstrap CSS -->
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/vendor/fontawesome/all.min.css">
    
    <!-- DataTables -->
    <link rel="stylesheet" href="/vendor/datatables/dataTables.bootstrap5.min.css">
    
    <style>
        :root {
            --primary-color: #1e3a8a;
            --secondary-color: #3b82f6;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --dark-color: #1f2937;
            --light-color: #f8fafc;
        }
        
        body {
            background-color: var(--light-color);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .sidebar {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            min-height: 100vh;
            box-shadow: 2px 0 10px rgba(0,0,0,0.1);
        }
        
        .sidebar .nav-link {
            color: rgba(255,255,255,0.9);
            padding: 0.75rem 1rem;
            margin: 0.25rem 0;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }
        
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background-color: rgba(255,255,255,0.2);
            color: white;
            transform: translateX(5px);
        }
        
        .card {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        
        .iso-logo {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: bold;
            margin-right: 10px;
        }
        
        .table th {
            background-color: var(--primary-color);
            color: white;
            border: none;
        }
        
        .badge-critical { background-color: var(--danger-color); }
        .badge-high { background-color: #ff6b35; }
        .badge-medium { background-color: var(--warning-color); }
        .badge-low { background-color: var(--success-color); }
    </style>
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 sidebar isms-sidebar">
                <div class="position-sticky pt-3">
                    <div class="d-flex align-items-center mb-4">
                        <div class="iso-logo">ISO</div>
                        <h5 class="text-white mb-0">27001 ISMS</h5>
                    </div>
                    
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" href="/">
                                <i class="fas fa-tachometer-alt me-2"></i>
                                لوحة التحكم
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" href="/assets">
                                <i class="fas fa-server me-2"></i>
                                إدارة الأصول
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/risks">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                إدارة المخاطر
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/incidents">
                                <i class="fas fa-bell me-2"></i>
                                الحوادث
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/policies">
                                <i class="fas fa-file-alt me-2"></i>
                                السياسات
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/controls">
                                <i class="fas fa-shield-alt me-2"></i>
                                الضوابط الأمنية
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/audits">
                                <i class="fas fa-search me-2"></i>
                                التدقيقات
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/reports">
                                <i class="fas fa-chart-bar me-2"></i>
                                التقارير
                            </a>
                        </li>
                    </ul>
                    
                    <hr class="text-white my-4">
                    
                    <div class="text-white small">
                        <h6 class="text-white">عمل الطالب محمد علي طاهر</h6>
                        <p class="mb-1">إدارة أمن المعلومات</p>
                        <p class="mb-0">التطبيق الاحترافي</p>
                    </div>
                </div>
            </nav>
            
            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="pt-3 pb-2 mb-3">
                    <!-- Header -->
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center border-bottom mb-4">
                        <h1 class="h2 text-primary">
                            <i class="fas fa-server me-2"></i>
                            إدارة الأصول
                        </h1>
                        <div class="btn-toolbar mb-2 mb-md-0">
                            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addAssetModal">
                                <i class="fas fa-plus me-1"></i>
                                إضافة أصل
                            </button>
                        </div>
                    </div>
                    
                    <!-- Asset Statistics -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card text-center bg-primary text-white">
                                <div class="card-body">
                                    <h3><%= assets.length %></h3>
                                    <p class="mb-0">إجمالي الأصول</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-success text-white">
                                <div class="card-body">
                                    <h3><%= assets.filter(a => a.status === 'Active').length %></h3>
                                    <p class="mb-0">أصول نشطة</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-warning text-white">
                                <div class="card-body">
                                    <h3><%= assets.filter(a => a.classification === 'Critical').length %></h3>
                                    <p class="mb-0">أصول حرجة</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-danger text-white">
                                <div class="card-body">
                                    <h3><%= assets.filter(a => a.riskLevel === 'High').length %></h3>
                                    <p class="mb-0">أصول عالية الخطورة</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Assets Table -->
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-list me-2"></i>
                                جرد الأصول (ISO 27001 A.8.1.1)
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped data-table" id="assetsTable">
                                    <thead>
                                        <tr>
                                            <th>اسم الأصل</th>
                                            <th>النوع</th>
                                            <th>التصنيف</th>
                                            <th>المالك</th>
                                            <th>الموقع</th>
                                            <th>مستوى الخطر</th>
                                            <th>آخر تقييم</th>
                                            <th>الحالة</th>
                                            <th>الإجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% assets.forEach(asset => { %>
                                            <%
                                                // `classification` used to be dereferenced
                                                // unguarded, so a POST without the field
                                                // crashed the whole page with a 500.
                                                const typeIcon = { Server: 'server', Database: 'database', Hardware: 'laptop', Network: 'network-wired', Cloud: 'cloud', Application: 'window-maximize' };
                                                const classTone = { Critical: 'danger', High: 'danger', Medium: 'warning', Low: 'success' };
                                                const riskTone = { High: 'danger', Medium: 'warning', Low: 'success' };
                                                // ISO 8601 in a data attribute so DataTables
                                                // sorts real dates instead of DD/MM/YYYY strings.
                                                const assessedSort = moment(asset.lastAssessed, 'YYYY-MM-DD').isValid() ? asset.lastAssessed : '';
                                            %>
                                            <tr>
                                                <td>
                                                    <i class="fas fa-<%= typeIcon[asset.type] || 'server' %> me-2"></i>
                                                    <%= asset.name %>
                                                </td>
                                                <td><%= ar('assetType', asset.type) %></td>
                                                <td>
                                                    <span class="badge bg-<%= classTone[asset.classification] || 'secondary' %>">
                                                        <%= ar('classification', asset.classification) %>
                                                    </span>
                                                </td>
                                                <td><%= asset.owner %></td>
                                                <td><%= asset.location %></td>
                                                <td>
                                                    <span class="badge bg-<%= riskTone[asset.riskLevel] || 'secondary' %>">
                                                        <%= ar('riskLevel', asset.riskLevel) %>
                                                    </span>
                                                </td>
                                                <td data-sort="<%= assessedSort %>"><%= moment(asset.lastAssessed).isValid() ? moment(asset.lastAssessed).format('DD/MM/YYYY') : '—' %></td>
                                                <td>
                                                    <span class="badge bg-<%= asset.status === 'Active' ? 'success' : 'secondary' %>">
                                                        <%= ar('status', asset.status) %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary" title="تعديل الأصل" type="button">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-info" title="عرض التفاصيل" type="button">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    
    <!-- إضافة أصل Modal -->
    <div class="modal fade" id="addAssetModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">
                        <i class="fas fa-plus me-2"></i>
                        إضافة أصل جديد
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/assets" method="POST">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="name" class="form-label">اسم الأصل *</label>
                                    <input type="text" class="form-control" id="name" name="name" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="type" class="form-label">نوع الأصل *</label>
                                    <select class="form-select" id="type" name="type" required>
                                        <option value="">اختر النوع</option>
                                        <option value="Server">خادم</option>
                                        <option value="Database">قاعدة بيانات</option>
                                        <option value="Application">تطبيق</option>
                                        <option value="Network">معدات شبكة</option>
                                        <option value="Hardware">أجهزة ومعدات</option>
                                        <option value="Cloud">خدمة سحابية</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="classification" class="form-label">التصنيف *</label>
                                    <select class="form-select" id="classification" name="classification" required>
                                        <option value="">اختر التصنيف</option>
                                        <option value="Critical">حرج</option>
                                        <option value="High">مرتفع</option>
                                        <option value="Medium">متوسط</option>
                                        <option value="Low">منخفض</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="owner" class="form-label">مالك الأصل *</label>
                                    <input type="text" class="form-control" id="owner" name="owner" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="location" class="form-label">الموقع *</label>
                                    <input type="text" class="form-control" id="location" name="location" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="riskLevel" class="form-label">مستوى الخطر *</label>
                                    <select class="form-select" id="riskLevel" name="riskLevel" required>
                                        <option value="">اختر مستوى الخطر</option>
                                        <option value="High">مرتفع</option>
                                        <option value="Medium">متوسط</option>
                                        <option value="Low">منخفض</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>
                            إضافة أصل
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    
    <!-- jQuery -->
    <script src="/vendor/jquery/jquery.min.js"></script>
    
    <!-- DataTables -->
    <script src="/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="/vendor/datatables/dataTables.bootstrap5.min.js"></script>
    
    <script>
        // `responsive: true` silently did nothing: the DataTables Responsive
        // extension was never loaded. The column carries data-sort="YYYY-MM-DD"
        // so the date column sorts chronologically instead of lexicographically.
        if (window.jQuery && jQuery.fn && jQuery.fn.DataTable) {
            jQuery(document).ready(function() {
                $('#assetsTable').DataTable({
                    pageLength: 10,
                    order: [[6, 'desc']], // Sort by آخر تقييم date
                    columnDefs: [
                        { orderable: false, targets: 8 } // Disable sorting for الإجراءات column
                    ],
                    language: {
                        emptyTable: 'لا توجد أصول مسجلة',
                        search: 'بحث:',
                        lengthMenu: 'عرض _MENU_ سجل لكل صفحة',
                        info: 'عرض _START_ إلى _END_ من _TOTAL_ سجل'
                    }
                });
            });
        }
    </script>
    <script src="/js/main.js"></script>
</body>
</html>
