<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= message || 'حدث خطأ' %> - نظام إدارة أمن المعلومات</title>
  <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/vendor/fontawesome/all.min.css">
  <link rel="stylesheet" href="/css/custom.css">
  <style>
    .error-page { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
    .error-card { max-width: 620px; width: 100%; text-align: center; padding: 42px 28px; }
    .error-icon { width: 78px; height: 78px; margin: 0 auto 22px; display: grid; place-items: center; border-radius: 22px; color: #fff; background: linear-gradient(135deg, #ef4444, #b91c1c); font-size: 32px; box-shadow: 0 14px 26px rgba(239,68,68,.2); }
    .error-code { color: #98a2b3; font-size: 12px; margin-top: 18px; direction: ltr; text-align: left; white-space: pre-wrap; }
  </style>
</head>
<body class="page-ready">
  <main class="error-page">
    <section class="card error-card">
      <div class="error-icon"><i class="fas fa-triangle-exclamation"></i></div>
      <h1 class="h3 mb-3">عذرًا، حدث خطأ</h1>
      <p class="text-muted mb-4"><%= message || 'تعذر تحميل الصفحة المطلوبة. حاول مرة أخرى.' %></p>
      <a class="btn btn-primary" href="/">
        <i class="fas fa-arrow-left me-1"></i>العودة إلى لوحة التحكم
      </a>
      <% if (error && error.stack) { %>
        <details class="error-code mt-4">
          <summary>تفاصيل الخطأ</summary>
          <%= error.stack %>
        </details>
      <% } %>
    </section>
  </main>
</body>
</html>
