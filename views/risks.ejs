<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة المخاطر - ISO 27001 ISMS</title>
    
    <!-- Bootstrap CSS -->
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/vendor/fontawesome/all.min.css">
    
    <!-- DataTables -->
    <link rel="stylesheet" href="/vendor/datatables/dataTables.bootstrap5.min.css">
    
    <style>
        :root {
            --primary-color: #1e3a8a;
            --secondary-color: #3b82f6;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --light-color: #f8fafc;
        }
        
        body { background-color: var(--light-color); font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); min-height: 100vh; box-shadow: 2px 0 10px rgba(0,0,0,0.1); }
        .sidebar .nav-link { color: rgba(255,255,255,0.9); padding: 0.75rem 1rem; margin: 0.25rem 0; border-radius: 0.5rem; transition: all 0.3s ease; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: rgba(255,255,255,0.2); color: white; transform: translateX(5px); }
        .card { border: none; border-radius: 1rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .iso-logo { width: 40px; height: 40px; background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; margin-right: 10px; }
.table th { background-color: var(--primary-color); color: white; border: none; }
        .risk-matrix { display: grid; grid-template-columns: repeat(6, 1fr); gap: 2px; margin: 1rem 0; }
        .risk-cell { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-weight: bold; color: white; border-radius: 4px; }
        .risk-low { background-color: var(--success-color); }
        .risk-medium { background-color: var(--warning-color); }
        .risk-high { background-color: var(--danger-color); }
        .risk-critical { background-color: #8b0000; }
    </style>
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 sidebar isms-sidebar">
                <div class="position-sticky pt-3">
                    <div class="d-flex align-items-center mb-4">
                        <div class="iso-logo">ISO</div>
                        <h5 class="text-white mb-0">27001 ISMS</h5>
                    </div>
                    
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-tachometer-alt me-2"></i>لوحة التحكم</a></li>
                        <li class="nav-item"><a class="nav-link" href="/assets"><i class="fas fa-server me-2"></i>إدارة الأصول</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/risks"><i class="fas fa-exclamation-triangle me-2"></i>إدارة المخاطر</a></li>
                        <li class="nav-item"><a class="nav-link" href="/incidents"><i class="fas fa-bell me-2"></i>الحوادث</a></li>
                        <li class="nav-item"><a class="nav-link" href="/policies"><i class="fas fa-file-alt me-2"></i>السياسات</a></li>
                        <li class="nav-item"><a class="nav-link" href="/controls"><i class="fas fa-shield-alt me-2"></i>الضوابط الأمنية</a></li>
                        <li class="nav-item"><a class="nav-link" href="/audits"><i class="fas fa-search me-2"></i>التدقيقات</a></li>
                        <li class="nav-item"><a class="nav-link" href="/reports"><i class="fas fa-chart-bar me-2"></i>التقارير</a></li>
                    </ul>
                    
                    <hr class="text-white my-4">
                    
                    <div class="text-white small">
                        <h6 class="text-white">عمل الطالب محمد علي طاهر</h6>
                        <p class="mb-1">إدارة أمن المعلومات</p>
                        <p class="mb-0">التطبيق الاحترافي</p>
                    </div>
                </div>
            </nav>
            
            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="pt-3 pb-2 mb-3">
                    <!-- Header -->
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center border-bottom mb-4">
                        <h1 class="h2 text-primary">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            إدارة المخاطر (ISO 27001 A.6.1.2)
                        </h1>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRiskModal">
                            <i class="fas fa-plus me-1"></i>إضافة خطر
                        </button>
                    </div>
                    
                    <!-- Risk Statistics -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card text-center bg-danger text-white">
                                <div class="card-body">
                                    <h3><%= risks.filter(r => r.riskScore >= 15).length %></h3>
                                    <p class="mb-0">مخاطر مرتفعة</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-warning text-white">
                                <div class="card-body">
                                    <h3><%= risks.filter(r => r.riskScore >= 8 && r.riskScore < 15).length %></h3>
                                    <p class="mb-0">مخاطر متوسطة</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-success text-white">
                                <div class="card-body">
                                    <h3><%= risks.filter(r => r.riskScore < 8).length %></h3>
                                    <p class="mb-0">مخاطر منخفضة</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-primary text-white">
                                <div class="card-body">
                                    <h3><%= risks.filter(r => r.status === 'Open').length %></h3>
                                    <p class="mb-0">مخاطر مفتوحة</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Risk Matrix -->
                    <div class="card mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-table me-2"></i>مصفوفة تقييم المخاطر</h5>
                        </div>
                        <div class="card-body">
                            <div class="risk-matrix">
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center">الأثر ←<br>الاحتمالية ↓</div>
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center">منخفض جدًا (1)</div>
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center">منخفض (2)</div>
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center">متوسط (3)</div>
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center">مرتفع (4)</div>
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center">مرتفع جدًا (5)</div>
                                
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center">مرتفع جدًا (5)</div>
                                <div class="risk-cell risk-medium">5</div>
                                <div class="risk-cell risk-high">10</div>
                                <div class="risk-cell risk-high">15</div>
                                <div class="risk-cell risk-critical">20</div>
                                <div class="risk-cell risk-critical">25</div>
                                
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center">مرتفع (4)</div>
                                <div class="risk-cell risk-low">4</div>
                                <div class="risk-cell risk-medium">8</div>
                                <div class="risk-cell risk-medium">12</div>
                                <div class="risk-cell risk-high">16</div>
                                <div class="risk-cell risk-critical">20</div>
                                
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center">متوسط (3)</div>
                                <div class="risk-cell risk-low">3</div>
                                <div class="risk-cell risk-low">6</div>
                                <div class="risk-cell risk-medium">9</div>
                                <div class="risk-cell risk-medium">12</div>
                                <div class="risk-cell risk-high">15</div>
                                
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center">منخفض (2)</div>
                                <div class="risk-cell risk-low">2</div>
                                <div class="risk-cell risk-low">4</div>
                                <div class="risk-cell risk-low">6</div>
                                <div class="risk-cell risk-medium">8</div>
                                <div class="risk-cell risk-medium">10</div>
                                
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center">منخفض جدًا (1)</div>
                                <div class="risk-cell risk-low">1</div>
                                <div class="risk-cell risk-low">2</div>
                                <div class="risk-cell risk-low">3</div>
                                <div class="risk-cell risk-low">4</div>
                                <div class="risk-cell risk-medium">5</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- سجل المخاطر -->
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-list me-2"></i>سجل المخاطر</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped data-table" id="risksTable">
                                    <thead>
                                        <tr>
                                            <th>عنوان الخطر</th>
                                            <th>التصنيف</th>
                                            <th>الاحتمالية</th>
                                            <th>الأثر</th>
                                            <th>درجة الخطر</th>
                                            <th>الحالة</th>
                                            <th>المالك</th>
                                            <th>تاريخ الاستحقاق</th>
                                            <th>الإجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% risks.forEach(risk => { %>
                                            <%
                                                const scoreTone = risk.riskScore >= 15 ? 'danger' : risk.riskScore >= 8 ? 'warning' : 'success';
                                                const statusTone = risk.status === 'Open' ? 'danger' : risk.status === 'In Progress' ? 'warning' : 'success';
                                                const dueSort = moment(risk.dueDate, 'YYYY-MM-DD').isValid() ? risk.dueDate : '';
                                            %>
                                            <tr>
                                                <td>
                                                    <strong><%= risk.title %></strong><br>
                                                    <small class="text-muted"><%= risk.description %></small>
                                                </td>
                                                <td><%= ar('riskCategory', risk.category) %></td>
                                                <td><%= riskScaleLabel(risk.probability) %></td>
                                                <td><%= riskScaleLabel(risk.impact) %></td>
                                                <td>
                                                    <span class="badge bg-<%= scoreTone %>">
                                                        <%= risk.riskScore %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <span class="badge bg-<%= statusTone %>">
                                                        <%= ar('status', risk.status) %>
                                                    </span>
                                                </td>
                                                <td><%= risk.owner %></td>
                                                <td data-sort="<%= dueSort %>"><%= moment(risk.dueDate).isValid() ? moment(risk.dueDate).format('DD/MM/YYYY') : '—' %></td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary" title="تعديل الخطر" type="button">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-info" title="عرض التفاصيل" type="button">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    
    <!-- إضافة خطر Modal -->
    <div class="modal fade" id="addRiskModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fas fa-plus me-2"></i>إضافة خطر جديد</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/risks" method="POST">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="title" class="form-label">عنوان الخطر *</label>
                                    <input type="text" class="form-control" id="title" name="title" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="category" class="form-label">التصنيف *</label>
                                    <select class="form-select" id="category" name="category" required>
                                        <option value="">اختر التصنيف</option>
                                        <option value="Data Security">أمن البيانات</option>
                                        <option value="System Security">أمن الأنظمة</option>
                                        <option value="Network Security">أمن الشبكات</option>
                                        <option value="Physical Security">الأمن المادي</option>
                                        <option value="Human Factor">العامل البشري</option>
                                        <option value="Operational">التشغيل</option>
                                        <option value="Legal &amp; Compliance">القانون والامتثال</option>
                                        <option value="Business Continuity">استمرارية الأعمال</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="description" class="form-label">الوصف *</label>
                                    <textarea class="form-control" id="description" name="description" rows="3" required></textarea>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="probability" class="form-label">الاحتمالية (1-5) *</label>
                                    <select class="form-select" id="probability" name="probability" required>
                                        <option value="">اختر الاحتمالية</option>
                                        <option value="1">1 - منخفض جدًا</option>
                                        <option value="2">2 - منخفض</option>
                                        <option value="3">3 - متوسط</option>
                                        <option value="4">4 - مرتفع</option>
                                        <option value="5">5 - مرتفع جدًا</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="impact" class="form-label">الأثر (1-5) *</label>
                                    <select class="form-select" id="impact" name="impact" required>
                                        <option value="">اختر الأثر</option>
                                        <option value="1">1 - منخفض جدًا</option>
                                        <option value="2">2 - منخفض</option>
                                        <option value="3">3 - متوسط</option>
                                        <option value="4">4 - مرتفع</option>
                                        <option value="5">5 - مرتفع جدًا</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="owner" class="form-label">مالك الخطر *</label>
                                    <input type="text" class="form-control" id="owner" name="owner" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="dueDate" class="form-label">تاريخ الاستحقاق *</label>
                                    <input type="date" class="form-control" id="dueDate" name="dueDate" required>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="mitigation" class="form-label">استراتيجية التخفيف</label>
                                    <textarea class="form-control" id="mitigation" name="mitigation" rows="3"></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>إضافة خطر</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="/vendor/datatables/dataTables.bootstrap5.min.js"></script>
    
    <script>
        if (window.jQuery && jQuery.fn && jQuery.fn.DataTable) {
            jQuery(document).ready(function() {
                $('#risksTable').DataTable({
                    pageLength: 10,
                    order: [[4, 'desc']], // Sort by درجة الخطر
                    language: {
                        emptyTable: 'لا توجد مخاطر مسجلة',
                        search: 'بحث:',
                        lengthMenu: 'عرض _MENU_ سجل لكل صفحة',
                        info: 'عرض _START_ إلى _END_ من _TOTAL_ سجل'
                    }
                });
            });
        }
    </script>
    <script src="/js/main.js"></script>
</body>
</html>
