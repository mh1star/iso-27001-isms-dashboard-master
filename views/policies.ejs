<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إدارة السياسات - ISO 27001 ISMS</title>
    
    <!-- Bootstrap CSS -->
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/vendor/fontawesome/all.min.css">
    
    <!-- DataTables -->
    <link rel="stylesheet" href="/vendor/datatables/dataTables.bootstrap5.min.css">
    
    <style>
        :root {
            --primary-color: #1e3a8a;
            --secondary-color: #3b82f6;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --light-color: #f8fafc;
        }
        body { background-color: var(--light-color); font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); min-height: 100vh; box-shadow: 2px 0 10px rgba(0,0,0,0.1); }
        .sidebar .nav-link { color: rgba(255,255,255,0.9); padding: 0.75rem 1rem; margin: 0.25rem 0; border-radius: 0.5rem; transition: all 0.3s ease; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: rgba(255,255,255,0.2); color: white; transform: translateX(5px); }
        .card { border: none; border-radius: 1rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .iso-logo { width: 40px; height: 40px; background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; margin-right: 10px; }
.table th { background-color: var(--primary-color); color: white; border: none; }
        .policy-card { border-left: 4px solid var(--primary-color); }
        .policy-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.15); }
    </style>
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 sidebar isms-sidebar">
                <div class="position-sticky pt-3">
                    <div class="d-flex align-items-center mb-4">
                        <div class="iso-logo">ISO</div>
                        <h5 class="text-white mb-0">27001 ISMS</h5>
                    </div>
                    
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-tachometer-alt me-2"></i>لوحة التحكم</a></li>
                        <li class="nav-item"><a class="nav-link" href="/assets"><i class="fas fa-server me-2"></i>إدارة الأصول</a></li>
                        <li class="nav-item"><a class="nav-link" href="/risks"><i class="fas fa-exclamation-triangle me-2"></i>إدارة المخاطر</a></li>
                        <li class="nav-item"><a class="nav-link" href="/incidents"><i class="fas fa-bell me-2"></i>الحوادث</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/policies"><i class="fas fa-file-alt me-2"></i>السياسات</a></li>
                        <li class="nav-item"><a class="nav-link" href="/controls"><i class="fas fa-shield-alt me-2"></i>الضوابط الأمنية</a></li>
                        <li class="nav-item"><a class="nav-link" href="/audits"><i class="fas fa-search me-2"></i>التدقيقات</a></li>
                        <li class="nav-item"><a class="nav-link" href="/reports"><i class="fas fa-chart-bar me-2"></i>التقارير</a></li>
                    </ul>
                    
                    <hr class="text-white my-4">
                    
                    <div class="text-white small">
                        <h6 class="text-white">عمل الطالب محمد علي طاهر</h6>
                        <p class="mb-1">إدارة أمن المعلومات</p>
                        <p class="mb-0">التطبيق الاحترافي</p>
                    </div>
                </div>
            </nav>
            
            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="pt-3 pb-2 mb-3">
                    <!-- Header -->
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center border-bottom mb-4">
                        <h1 class="h2 text-primary">
                            <i class="fas fa-file-alt me-2"></i>
                            إدارة السياسات (ISO 27001 A.5.1)
                        </h1>
                        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPolicyModal">
                            <i class="fas fa-plus me-1"></i>إضافة سياسة
                        </button>
                    </div>
                    
                    <!-- Policy Statistics -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card text-center bg-primary text-white">
                                <div class="card-body">
                                    <h3><%= policies.length %></h3>
                                    <p class="mb-0">إجمالي السياسات</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-success text-white">
                                <div class="card-body">
                                    <h3><%= policies.filter(p => p.status === 'Active').length %></h3>
                                    <p class="mb-0">السياسات النشطة</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-warning text-white">
                                <div class="card-body">
                                    <h3><%= policies.filter(p => moment(p.reviewDate).isValid() && moment(p.reviewDate).diff(moment(), 'days') <= 30).length %></h3>
                                    <p class="mb-0">مستحقة للمراجعة</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center bg-info text-white">
                                <div class="card-body">
                                    <h3><%= new Set(policies.map(p => p.category)).size %></h3>
                                    <p class="mb-0">التصنيفات</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- نظرة عامة على إطار السياسات -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="fas fa-sitemap me-2"></i>إطار سياسات ISO 27001</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <h6 class="text-primary">السياسات التنظيمية</h6>
                                            <ul class="list-unstyled">
                                                <li><i class="fas fa-check-circle text-success me-2"></i>سياسة أمن المعلومات</li>
                                                <li><i class="fas fa-check-circle text-success me-2"></i>سياسة إدارة المخاطر</li>
                                                <li><i class="fas fa-check-circle text-success me-2"></i>سياسة الاستجابة للحوادث</li>
                                                <li><i class="fas fa-exclamation-circle text-warning me-2"></i>سياسة استمرارية الأعمال</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-4">
                                            <h6 class="text-primary">السياسات التقنية</h6>
                                            <ul class="list-unstyled">
                                                <li><i class="fas fa-check-circle text-success me-2"></i>سياسة التحكم بالوصول</li>
                                                <li><i class="fas fa-check-circle text-success me-2"></i>سياسة التشفير</li>
                                                <li><i class="fas fa-exclamation-circle text-warning me-2"></i>سياسة أمن الشبكات</li>
                                                <li><i class="fas fa-times-circle text-danger me-2"></i>سياسة الأجهزة المحمولة</li>
                                            </ul>
                                        </div>
                                        <div class="col-md-4">
                                            <h6 class="text-primary">السياسات التشغيلية</h6>
                                            <ul class="list-unstyled">
                                                <li><i class="fas fa-check-circle text-success me-2"></i>سياسة حماية البيانات</li>
                                                <li><i class="fas fa-exclamation-circle text-warning me-2"></i>سياسة النسخ الاحتياطي والاستعادة</li>
                                                <li><i class="fas fa-times-circle text-danger me-2"></i>سياسة أمن الموردين</li>
                                                <li><i class="fas fa-times-circle text-danger me-2"></i>سياسة الأمن المادي</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Policy Cards -->
                    <div class="row mb-4">
                        <% policies.forEach(policy => { %>
                            <%
                                const reviewInDays = moment(policy.reviewDate).isValid()
                                    ? moment(policy.reviewDate).diff(moment(), 'days')
                                    : null;
                            %>
                            <div class="col-md-6 mb-3">
                                <div class="card policy-card h-100">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <h5 class="card-title text-primary mb-0">
                                                <i class="fas fa-file-contract me-2"></i>
                                                <%= policy.title %>
                                            </h5>
                                            <span class="badge bg-<%= policy.status === 'Active' ? 'success' : policy.status === 'Under Review' ? 'warning' : 'secondary' %>">
                                                <%= ar('status', policy.status) %>
                                            </span>
                                        </div>
                                        <p class="card-text text-muted"><%= policy.description %></p>
                                        <div class="row small">
                                            <div class="col-6">
                                                <strong>الإصدار:</strong> <%= policy.version %>
                                            </div>
                                            <div class="col-6">
                                                <strong>التصنيف:</strong> <%= ar('policyCategory', policy.category) %>
                                            </div>
                                            <div class="col-6">
                                                <strong>اعتمد بواسطة:</strong> <%= policy.approvedBy %>
                                            </div>
                                            <div class="col-6">
                                                <strong>تاريخ الاعتماد:</strong> <%= moment(policy.approvedDate).isValid() ? moment(policy.approvedDate).format('DD/MM/YYYY') : '—' %>
                                            </div>
                                            <div class="col-12 mt-2">
                                                <strong>المراجعة القادمة:</strong> 
                                                <span class="<%= reviewInDays !== null && reviewInDays <= 30 ? 'text-warning' : 'text-muted' %>">
                                                    <%= moment(policy.reviewDate).isValid() ? moment(policy.reviewDate).format('DD/MM/YYYY') : '—' %>
                                                    <% if (reviewInDays !== null) { %>(<%= moment(policy.reviewDate).fromNow() %>)<% } %>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="mt-3">
                                            <button class="btn btn-sm btn-outline-primary me-2" type="button">
                                                <i class="fas fa-eye"></i> عرض
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary me-2" type="button">
                                                <i class="fas fa-edit"></i> تعديل
                                            </button>
                                            <button class="btn btn-sm btn-outline-info">
                                                <i class="fas fa-download"></i> تنزيل
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    
                    <!-- السياسات Table -->
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-list me-2"></i>سجل السياسات</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped data-table" id="policiesTable">
                                    <thead>
                                        <tr>
                                            <th>عنوان السياسة</th>
                                            <th>الإصدار</th>
                                            <th>التصنيف</th>
                                            <th>الحالة</th>
                                            <th>اعتمد بواسطة</th>
                                            <th>تاريخ الاعتماد</th>
                                            <th>تاريخ المراجعة</th>
                                            <th>الإجراءات</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% policies.forEach(policy => { %>
                                            <tr>
                                                <td>
                                                    <strong><%= policy.title %></strong><br>
                                                    <small class="text-muted"><%= policy.description %></small>
                                                </td>
                                                <td><%= policy.version %></td>
                                                <td><%= ar('policyCategory', policy.category) %></td>
                                                <td>
                                                    <span class="badge bg-<%= policy.status === 'Active' ? 'success' : policy.status === 'Under Review' ? 'warning' : 'secondary' %>">
                                                        <%= ar('status', policy.status) %>
                                                    </span>
                                                </td>
                                                <td><%= policy.approvedBy %></td>
                                                <td data-sort="<%= policy.approvedDate %>"><%= moment(policy.approvedDate).isValid() ? moment(policy.approvedDate).format('DD/MM/YYYY') : '—' %></td>
                                                <td data-sort="<%= policy.reviewDate %>">
                                                    <span class="<%= moment(policy.reviewDate).isValid() && moment(policy.reviewDate).diff(moment(), 'days') <= 30 ? 'text-warning fw-bold' : '' %>">
                                                        <%= moment(policy.reviewDate).isValid() ? moment(policy.reviewDate).format('DD/MM/YYYY') : '—' %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary" title="تعديل السياسة" type="button">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                    <button class="btn btn-sm btn-outline-info" title="عرض السياسة" type="button">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    
    <!-- إضافة سياسة Modal — the header button targeted this id but the element
         did not exist, so "إضافة سياسة" was a dead button. -->
    <div class="modal fade" id="addPolicyModal" tabindex="-1" aria-labelledby="addPolicyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="addPolicyModalLabel"><i class="fas fa-plus me-2"></i>إضافة سياسة جديدة</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <form action="/policies" method="POST">
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label for="title" class="form-label">عنوان السياسة *</label>
                                    <input type="text" class="form-control" id="title" name="title" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="version" class="form-label">الإصدار *</label>
                                    <input type="text" class="form-control" id="version" name="version" value="1.0" required>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="mb-3">
                                    <label for="description" class="form-label">الوصف *</label>
                                    <textarea class="form-control" id="description" name="description" rows="3" required></textarea>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="category" class="form-label">التصنيف *</label>
                                    <select class="form-select" id="category" name="category" required>
                                        <option value="">اختر التصنيف</option>
                                        <option value="Security">الأمن</option>
                                        <option value="Access Control">التحكم بالوصول</option>
                                        <option value="Operations">العمليات</option>
                                        <option value="Human Resources">الموارد البشرية</option>
                                        <option value="Business Continuity">استمرارية الأعمال</option>
                                        <option value="Compliance">الامتثال</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="status" class="form-label">الحالة *</label>
                                    <select class="form-select" id="status" name="status" required>
                                        <option value="Draft">مسودة</option>
                                        <option value="Under Review">قيد المراجعة</option>
                                        <option value="Active">نشط</option>
                                        <option value="Archived">مؤرشف</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="approvedBy" class="form-label">اعتمد بواسطة *</label>
                                    <input type="text" class="form-control" id="approvedBy" name="approvedBy" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="approvedDate" class="form-label">تاريخ الاعتماد *</label>
                                    <input type="date" class="form-control" id="approvedDate" name="approvedDate" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="reviewDate" class="form-label">تاريخ المراجعة القادمة *</label>
                                    <input type="date" class="form-control" id="reviewDate" name="reviewDate" required>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>حفظ السياسة</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/vendor/jquery/jquery.min.js"></script>
    <script src="/vendor/datatables/jquery.dataTables.min.js"></script>
    <script src="/vendor/datatables/dataTables.bootstrap5.min.js"></script>
    
    <script>
        if (window.jQuery && jQuery.fn && jQuery.fn.DataTable) {
            jQuery(document).ready(function() {
                $('#policiesTable').DataTable({
                    pageLength: 10,
                    order: [[6, 'asc']], // Sort by تاريخ المراجعة
                    language: {
                        emptyTable: 'لا توجد سياسات مسجلة',
                        search: 'بحث:',
                        lengthMenu: 'عرض _MENU_ سجل لكل صفحة',
                        info: 'عرض _START_ إلى _END_ من _TOTAL_ سجل'
                    }
                });
            });
        }
    </script>
    <script src="/js/main.js"></script>
</body>
</html>
