<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>التقارير والتحليلات - ISO 27001 ISMS</title>
    
    <!-- Bootstrap CSS -->
    <link href="/vendor/bootstrap/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="/vendor/fontawesome/all.min.css">
    
    <!-- Chart.js -->
    <script src="/vendor/chartjs/chart.umd.js"></script>
    
    <style>
        :root {
            --primary-color: #1e3a8a;
            --secondary-color: #3b82f6;
            --success-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            --light-color: #f8fafc;
        }
        body { background-color: var(--light-color); font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .sidebar { background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); min-height: 100vh; box-shadow: 2px 0 10px rgba(0,0,0,0.1); }
        .sidebar .nav-link { color: rgba(255,255,255,0.9); padding: 0.75rem 1rem; margin: 0.25rem 0; border-radius: 0.5rem; transition: all 0.3s ease; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: rgba(255,255,255,0.2); color: white; transform: translateX(5px); }
        .card { border: none; border-radius: 1rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .iso-logo { width: 40px; height: 40px; background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; margin-right: 10px; }
.chart-container { position: relative; height: 300px; margin: 1rem 0; }
    </style>
    <link rel="stylesheet" href="/css/custom.css">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 sidebar isms-sidebar">
                <div class="position-sticky pt-3">
                    <div class="d-flex align-items-center mb-4">
                        <div class="iso-logo">ISO</div>
                        <h5 class="text-white mb-0">27001 ISMS</h5>
                    </div>
                    
                    <ul class="nav flex-column">
                        <li class="nav-item"><a class="nav-link" href="/"><i class="fas fa-tachometer-alt me-2"></i>لوحة التحكم</a></li>
                        <li class="nav-item"><a class="nav-link" href="/assets"><i class="fas fa-server me-2"></i>إدارة الأصول</a></li>
                        <li class="nav-item"><a class="nav-link" href="/risks"><i class="fas fa-exclamation-triangle me-2"></i>إدارة المخاطر</a></li>
                        <li class="nav-item"><a class="nav-link" href="/incidents"><i class="fas fa-bell me-2"></i>الحوادث</a></li>
                        <li class="nav-item"><a class="nav-link" href="/policies"><i class="fas fa-file-alt me-2"></i>السياسات</a></li>
                        <li class="nav-item"><a class="nav-link" href="/controls"><i class="fas fa-shield-alt me-2"></i>الضوابط الأمنية</a></li>
                        <li class="nav-item"><a class="nav-link" href="/audits"><i class="fas fa-search me-2"></i>التدقيقات</a></li>
                        <li class="nav-item"><a class="nav-link active" href="/reports"><i class="fas fa-chart-bar me-2"></i>التقارير</a></li>
                    </ul>
                    
                    <hr class="text-white my-4">
                    
                    <div class="text-white small">
                        <h6 class="text-white">عمل الطالب محمد علي طاهر</h6>
                        <p class="mb-1">إدارة أمن المعلومات</p>
                        <p class="mb-0">التطبيق الاحترافي</p>
                    </div>
                </div>
            </nav>
            
            <!-- Main content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="pt-3 pb-2 mb-3">
                    <!-- Header -->
                    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center border-bottom mb-4">
                        <h1 class="h2 text-primary">
                            <i class="fas fa-chart-bar me-2"></i>
                            التقارير والتحليلات
                        </h1>
                        <div class="btn-group" role="group">
                            <button class="btn btn-outline-primary">
                                <i class="fas fa-download me-1"></i>تصدير PDF
                            </button>
                            <button class="btn btn-outline-secondary">
                                <i class="fas fa-file-excel me-1"></i>تصدير Excel
                            </button>
                        </div>
                    </div>
                    
                    <!-- الملخص التنفيذي -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>الملخص التنفيذي</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-3 text-center">
                                            <h3 class="text-success"><%= data.kpis.controlsCompliance %>%</h3>
                                            <p class="text-muted">الامتثال العام</p>
                                        </div>
                                        <div class="col-md-3 text-center">
                                            <h3 class="text-warning"><%= data.kpis.openRisks %></h3>
                                            <p class="text-muted">المخاطر النشطة</p>
                                        </div>
                                        <div class="col-md-3 text-center">
                                            <h3 class="text-danger"><%= data.kpis.openIncidents %></h3>
                                            <p class="text-muted">الحوادث المفتوحة</p>
                                        </div>
                                        <div class="col-md-3 text-center">
                                            <h3 class="text-info"><%= data.kpis.overallEffectiveness %>%</h3>
                                            <p class="text-muted">متوسط فعالية الضوابط</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Charts Row 1 -->
                    <div class="row mb-4">
                        <div class="col-lg-6">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>توزيع المخاطر حسب التصنيف</h5>
                                </div>
                                <div class="card-body">
                                    <div class="chart-container">
                                        <canvas id="riskCategoryChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>اتجاهات الحوادث (آخر 6 أشهر)</h5>
                                </div>
                                <div class="card-body">
                                    <div class="chart-container">
                                        <canvas id="incidentTrendChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Charts Row 2 -->
                    <div class="row mb-4">
                        <div class="col-lg-6">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="fas fa-shield-alt me-2"></i>فعالية الضوابط</h5>
                                </div>
                                <div class="card-body">
                                    <div class="chart-container">
                                        <canvas id="controlEffectivenessChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="fas fa-chart-bar me-2"></i>الامتثال حسب التصنيف</h5>
                                </div>
                                <div class="card-body">
                                    <div class="chart-container">
                                        <canvas id="complianceChart"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Detailed التقارير -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header bg-primary text-white">
                                    <h5 class="mb-0"><i class="fas fa-file-alt me-2"></i>التقارير المتاحة</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-4 mb-3">
                                            <div class="card border-primary">
                                                <div class="card-body text-center">
                                                    <i class="fas fa-file-pdf fa-3x text-danger mb-3"></i>
                                                    <h6>تقرير تقييم المخاطر</h6>
                                                    <p class="text-muted small">تحليل شامل للمخاطر واستراتيجيات المعالجة</p>
                                                    <button class="btn btn-outline-primary btn-sm">
                                                        <i class="fas fa-download me-1"></i>تنزيل
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <div class="card border-success">
                                                <div class="card-body text-center">
                                                    <i class="fas fa-file-excel fa-3x text-success mb-3"></i>
                                                    <h6>مصفوفة الامتثال</h6>
                                                    <p class="text-muted small">حالة تطبيق ضوابط ISO 27001</p>
                                                    <button class="btn btn-outline-success btn-sm">
                                                        <i class="fas fa-download me-1"></i>تنزيل
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <div class="card border-warning">
                                                <div class="card-body text-center">
                                                    <i class="fas fa-file-powerpoint fa-3x text-warning mb-3"></i>
                                                    <h6>لوحة الإدارة التنفيذية</h6>
                                                    <p class="text-muted small">عرض موجز للوضع الأمني</p>
                                                    <button class="btn btn-outline-warning btn-sm">
                                                        <i class="fas fa-download me-1"></i>تنزيل
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <div class="card border-info">
                                                <div class="card-body text-center">
                                                    <i class="fas fa-file-alt fa-3x text-info mb-3"></i>
                                                    <h6>تقرير الاستجابة للحوادث</h6>
                                                    <p class="text-muted small">تحليل الحوادث الأمنية ومؤشرات الاستجابة</p>
                                                    <button class="btn btn-outline-info btn-sm">
                                                        <i class="fas fa-download me-1"></i>تنزيل
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <div class="card border-secondary">
                                                <div class="card-body text-center">
                                                    <i class="fas fa-file-csv fa-3x text-secondary mb-3"></i>
                                                    <h6>جرد الأصول</h6>
                                                    <p class="text-muted small">سجل الأصول الكامل مع التصنيفات</p>
                                                    <button class="btn btn-outline-secondary btn-sm">
                                                        <i class="fas fa-download me-1"></i>تنزيل
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-4 mb-3">
                                            <div class="card border-dark">
                                                <div class="card-body text-center">
                                                    <i class="fas fa-file-archive fa-3x text-dark mb-3"></i>
        <h6>حزمة التدقيق</h6>
        <p class="text-muted small">سجل تدقيق كامل مع الأدلة والمرفقات</p>
                                                    <button class="btn btn-outline-dark btn-sm">
                                                        <i class="fas fa-download me-1"></i>تنزيل
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    
    <!-- Bootstrap JS -->
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    
    <script>
        // All four charts were previously fixed literals that ignored the data
        // store entirely. The series are now rendered from server.js.
        const chartPalette = ['#20e4ff', '#a84dff', '#ff3b92', '#36efad', '#3188ff', '#f59e0b', '#8b5cf6', '#ef4444'];
        const emptyLabel = 'لا توجد بيانات';

        // Serialised with the server's json() helper rather than bare
        // JSON.stringify: the labels and control names come from the data store,
        // and a value carrying a closing script tag would end this block early.
        const riskByCategory = <%- json(data.riskByCategory) %>;
        const riskCategoryLabels = riskByCategory.map(item => item.label);
        const riskCategoryValues = riskByCategory.map(item => item.value);

        const incidentTrend = <%- json(data.incidentTrends) %>;
        const controlEffectiveness = <%- json(data.controlEffectiveness) %>;

        // Guard: an empty dataset makes Chart.js throw on a doughnut/radar.
        const safeData = (values) => (values.some(v => v > 0) ? values : [1]);

        // توزيع المخاطر حسب التصنيف
        new Chart(document.getElementById('riskCategoryChart').getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: riskCategoryLabels.length ? riskCategoryLabels : [emptyLabel],
                datasets: [{
                    data: safeData(riskCategoryValues),
                    backgroundColor: riskCategoryLabels.map((_, i) => chartPalette[i % chartPalette.length]),
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { color: '#dcecff' }
                    },
                    tooltip: {
                        callbacks: {
                            label: (ctx) => {
                                const total = riskCategoryValues.reduce((s, v) => s + v, 0);
                                if (!total) return ' 0';
                                return ` ${ctx.label}: ${ctx.parsed} (${Math.round((ctx.parsed / total) * 100)}%)`;
                            }
                        }
                    }
                }
            }
        });

        // اتجاهات الحوادث
        new Chart(document.getElementById('incidentTrendChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: incidentTrend.map(item => item.label),
                datasets: [
                    {
                        label: 'إجمالي الحوادث',
                        data: incidentTrend.map(item => item.count),
                        borderColor: '#ff3b92',
                        backgroundColor: 'rgba(255, 59, 146, 0.1)',
                        fill: true,
                        tension: 0.4
                    },
                    {
                        label: 'حوادث مرتفعة الخطورة',
                        data: incidentTrend.map(item => item.highSeverity),
                        borderColor: '#f59e0b',
                        backgroundColor: 'rgba(245, 158, 11, 0.1)',
                        fill: true,
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, color: '#7997bb' },
                        grid: { color: 'rgba(118, 192, 255, .12)' }
                    },
                    x: { ticks: { color: '#7997bb' }, grid: { color: 'rgba(118, 192, 255, .12)' } }
                },
                plugins: { legend: { labels: { color: '#dcecff' } } }
            }
        });

        // فعالية الضوابط
        new Chart(document.getElementById('controlEffectivenessChart').getContext('2d'), {
            type: 'radar',
            data: {
                labels: controlEffectiveness.length
                    ? controlEffectiveness.map(item => item.name)
                    : [emptyLabel],
                datasets: [{
                    label: 'مستوى الفعالية %',
                    data: controlEffectiveness.length
                        ? controlEffectiveness.map(item => item.effectiveness)
                        : [0],
                    backgroundColor: 'rgba(32, 228, 255, 0.2)',
                    borderColor: '#20e4ff',
                    borderWidth: 2,
                    pointBackgroundColor: '#20e4ff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    r: {
                        beginAtZero: true,
                        max: 100,
                        ticks: { color: '#7997bb', backdropColor: 'transparent' },
                        grid: { color: 'rgba(118, 192, 255, .18)' },
                        angleLines: { color: 'rgba(118, 192, 255, .18)' },
                        pointLabels: { color: '#dcecff' }
                    }
                },
                plugins: { legend: { labels: { color: '#dcecff' } } }
            }
        });

        // الامتثال حسب تصنيف الضوابط
        new Chart(document.getElementById('complianceChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: controlEffectiveness.length
                    ? controlEffectiveness.map(item => item.categoryLabel)
                    : [emptyLabel],
                datasets: [{
                    label: 'الفعالية %',
                    data: controlEffectiveness.length
                        ? controlEffectiveness.map(item => item.effectiveness)
                        : [0],
                    backgroundColor: controlEffectiveness.map(item => (
                        item.effectiveness >= 80 ? '#36efad' : item.effectiveness >= 60 ? '#f59e0b' : '#ff3b92'
                    )),
                    borderRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        ticks: {
                            color: '#7997bb',
                            callback: function(value) { return value + '%'; }
                        },
                        grid: { color: 'rgba(118, 192, 255, .12)' }
                    },
                    x: { ticks: { color: '#7997bb' }, grid: { display: false } }
                },
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: (ctx) => ` ${ctx.parsed.y}%` } }
                }
            }
        });
    </script>
    <script src="/js/main.js"></script>
</body>
</html>
